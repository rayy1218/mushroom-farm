[Unit]
Description=Mushroom farm app (:8080)
After=network-online.target mushroom-device.service
Wants=network-online.target

[Service]
User=farm
WorkingDirectory=/opt/mushroom-farm
Environment=TZ=Asia/Kuala_Lumpur NODE_ENV=production FARM_DB=/opt/mushroom-farm/data/v2.db
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/main.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
